{
  "name": "shinygo-desktop",
  "version": "1.0.0",
  "productName": "ShinyGODesktop",
  "description": "Electron wrapper for the ShinyGO app",
  "author": "You",
  "license": "MIT",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.2.0",
    "tar": "^6.2.1",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.shinygo",
    "productName": "ShinyGODesktop",
    "directories": {
      "buildResources": "build"  
    },
    "asar": false,
    "files": [    
      "main.js",
      "preload/**",
      "renderer/**",
      "node_modules/**",
      "package.json",
      "!resources/**",
      "!runtime/**"
    ],
    "extraResources": [
      { "from": "resources", "to": "." },  
      { "from": "runtime",   "to": "runtime" } ,
      { "from": "data",   "to": "data" } 
    ],

    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },

    "mac": {
      "category": "public.app-category.education",
      "target": ["dmg", "zip"],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "gatekeeperAssess": false
    },

    "linux": {
      "category": "Education",
      "target": ["AppImage", "deb"],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },

    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
